rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O cliente entra com Google; o barbeiro entra com sessão anônima +
    // PIN checado no app (ver auth.js/booking.js). Como os dois têm
    // request.auth preenchido, usamos o provedor de login pra diferenciar
    // quem é quem dentro das regras.
    function isSignedIn() {
      return request.auth != null;
    }

    function isClientSession() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isBarberSession() {
      return isSignedIn() &&
        request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    // Cada cliente só lê/edita o próprio perfil. Barbeiro pode ler todos
    // (precisa ver nome/telefone nos agendamentos).
    match /clients/{uid} {
      allow read: if isClientSession() && request.auth.uid == uid || isBarberSession();
      allow write: if isClientSession() && request.auth.uid == uid;
    }

    // Configuração pública do barbeiro (serviços, dias, horários, WhatsApp):
    // não é segredo nenhum, e o cliente precisa disso ANTES mesmo de logar
    // pra decidir se quer agendar — por isso a leitura é liberada geral.
    // O PIN NUNCA fica neste documento (ver barberSecrets abaixo).
    match /barberConfig/{doc} {
      allow read: if true;
      allow write: if isBarberSession();
    }

    // Só o hash do PIN (nunca o valor em texto puro) fica aqui, separado do
    // resto da configuração. Importante: como a sessão do barbeiro é uma
    // sessão anônima (qualquer visitante consegue criar uma sozinha, sem
    // precisar saber o PIN), esta regra reduz a exposição do hash pra quem
    // passou pelo fluxo do app, mas não é uma trava perfeita contra alguém
    // deliberadamente mal-intencionado que crie uma sessão anônima na mão.
    // Uma trava definitiva exigiria mover a comparação do PIN pra uma Cloud
    // Function, que nunca expõe o hash a nenhum cliente.
    match /barberSecrets/{doc} {
      allow read: if isBarberSession();
      allow write: if isBarberSession();
    }

    match /scheduleOverrides/{date} {
      allow read: if isSignedIn();
      allow write: if isBarberSession();
    }

    // Agendamentos: qualquer sessão logada pode ler (precisa ver horários
    // ocupados). Cliente só cria/cancela o próprio; barbeiro pode
    // cancelar e marcar como concluído qualquer um.
    match /appointments/{apptId} {
      allow read: if isSignedIn();
      allow create: if isClientSession() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if (isClientSession() && resource.data.uid == request.auth.uid) ||
        isBarberSession();
    }
  }
}
